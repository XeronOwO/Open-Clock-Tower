{
  "name": "openclocktower-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "gate": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.7",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.1",
    "@types/node": "^22.13.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.20.1",
    "eslint-plugin-vue": "^9.32.0",
    "playwright": "^1.63.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.0.11",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
