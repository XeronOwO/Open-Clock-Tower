<Project Sdk="Microsoft.NET.Sdk">

  <!-- 多客户端端到端：断线重连、双端一致、信息隔离。依赖见 Directory.Build.props -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!--
    传输面用例（M3）需要直接构造框架的转发头选项（Microsoft.AspNetCore.HttpOverrides）与
    ConfigureTestServices；Mvc.Testing 带过来的框架引用到不了那里，所以显式引一次。
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenClockTower.Kernel\OpenClockTower.Kernel.csproj" />
    <ProjectReference Include="..\..\src\OpenClockTower.Rules\OpenClockTower.Rules.csproj" />
    <ProjectReference Include="..\..\src\OpenClockTower.Application\OpenClockTower.Application.csproj" />
    <ProjectReference Include="..\..\src\OpenClockTower.Contracts\OpenClockTower.Contracts.csproj" />
    <ProjectReference Include="..\..\src\OpenClockTower.Server\OpenClockTower.Server.csproj" />
  </ItemGroup>

</Project>
