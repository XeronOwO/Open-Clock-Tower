* text=auto eol=lf

# Windows 批处理与 PowerShell 需要 CRLF 才能稳定运行
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary

# 锁文件不参与 diff 统计
pnpm-lock.yaml -diff
packages.lock.json -diff

# 语言统计
*.cs     linguist-language=C#
*.vue    linguist-language=Vue
*.ts     linguist-language=TypeScript
