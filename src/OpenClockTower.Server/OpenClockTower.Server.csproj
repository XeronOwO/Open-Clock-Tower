<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    宿主：认证、SignalR Hub、EF Core 持久化、节拍器。
    依赖方向：Server → Application → Rules → Kernel；本层不含任何领域判断（架构 §1）。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- 安全修复：EF Core 10.0.0 传递引入 SQLitePCLRaw.lib.e_sqlite3 2.1.11（已知高危漏洞），
         显式升级到 2.1.13（GHSA-2m69-gcr7-jv3q / CVE-2025-6965）。 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenClockTower.Application\OpenClockTower.Application.csproj" />
    <ProjectReference Include="..\OpenClockTower.Contracts\OpenClockTower.Contracts.csproj" />
  </ItemGroup>

</Project>
